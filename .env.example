# Grimhollow environment. Copy to `.env` and adjust; all values are optional.

# Port the server listens on (the client is served from the same origin).
PORT=3001

# Where the SQLite database lives. Defaults to server/src/data/grimhollow.sqlite.
# In Docker this is set to /data/grimhollow.sqlite.
# DB_PATH=./server/src/data/grimhollow.sqlite

# Optional LLM layer for NPC dialogue re-wording.
# The game is fully playable with it off — replies come from the built-in engine.
LLM_PROVIDER=off        # auto | local | cloud | off

# Local model (llama.cpp). Only used when LLM_PROVIDER=local or auto finds a model.
# LLM_LOCAL_URL=http://127.0.0.1:8080
# LLM_MODEL_PATH=./models/qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf
# LLM_LLAMA_BIN=./models/llama/llama-server

# Cloud model (any OpenAI-compatible endpoint). Only used when LLM_PROVIDER=cloud.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=30000
