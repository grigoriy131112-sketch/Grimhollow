{
  "session_start": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "timeout 60 bash \"$PWD/scripts/serve.sh\" >/tmp/grimhollow-hook.log 2>&1 </dev/null",
          "timeout": 90,
          "async": true
        }
      ]
    }
  ],
  "user_prompt_submit": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "timeout 60 bash \"$PWD/scripts/serve.sh\" >/tmp/grimhollow-hook.log 2>&1 </dev/null",
          "timeout": 90,
          "async": true
        }
      ]
    }
  ]
}
